# Markdown under docs/ is the source of truth and is tracked (PDFs are build artifacts)

# Exclude raw and processed datasets
/data/

# Exclude massive media and archive files
*.zip
*.mp4
*.mkv
*.avi

# Local tooling output (never commit)
graphify-out/
drafts/
*.lnk
kaggle/**/staging/

# Large Kaggle run outputs are published as datasets, not committed
experiments/runs/*/output/
